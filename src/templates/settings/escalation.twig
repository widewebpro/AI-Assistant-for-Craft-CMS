{% extends "craft-ai-assistant/settings/_layout" %}
{% import "_includes/forms" as forms %}
{% set title = "Settings" %}
{% set settingsTab = "escalation" %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('craft-ai-assistant/escalation/save') }}
    {{ redirectInput('craft-ai-assistant/settings/escalation') }}

    {{ parent() }}
{% endblock %}

{% block settingsContent %}
    <div class="pane" style="margin-bottom: 24px;">
        <h2>Escalation</h2>
        <p class="light">When the AI agent can't help or the user explicitly asks for a human, the conversation can be escalated for human review. A contact form will appear in the chat widget to collect the user's details.</p>

        {{ forms.lightswitchField({
            label: "Enable Escalation",
            instructions: "Allow the AI agent to escalate conversations for human review.",
            id: "escalationEnabled",
            name: "escalationEnabled",
            on: settings.escalationEnabled,
            toggle: '#escalation-settings',
        }) }}
    </div>

    <div id="escalation-settings" {% if not settings.escalationEnabled %}class="hidden"{% endif %}>
        <div class="pane" style="margin-bottom: 24px;">
            <h2>Sensitivity</h2>
            <p class="light">Controls how readily the agent agrees to escalate a conversation.</p>

            {{ forms.selectField({
                label: "Escalation Sensitivity",
                instructions: "How easily should the agent hand off to a human?",
                id: "escalationSensitivity",
                name: "escalationSensitivity",
                value: settings.escalationSensitivity,
                options: [
                    { label: "Low — Only when user explicitly demands a human", value: "low" },
                    { label: "Medium — When user clearly asks for human help (default)", value: "medium" },
                    { label: "High — Also when user seems frustrated or agent fails to help", value: "high" },
                ],
            }) }}
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>Messages</h2>

            {{ forms.textareaField({
                label: "Escalation Message",
                instructions: "Shown to the user when a conversation is escalated, before the contact form appears.",
                id: "escalationMessage",
                name: "escalationMessage",
                value: settings.escalationMessage,
                rows: 2,
                class: "fullwidth",
            }) }}

            {{ forms.textareaField({
                label: "Confirmation Message",
                instructions: "Shown after the user submits the contact form.",
                id: "escalationConfirmation",
                name: "escalationConfirmation",
                value: settings.escalationConfirmation,
                rows: 2,
                class: "fullwidth",
            }) }}
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>Contact Form Fields</h2>
            <p class="light">Define the fields shown in the escalation contact form. The <strong>Handle</strong> is the machine name used for field mapping and webhook payloads.</p>

            {{ forms.editableTableField({
                label: "Fields",
                id: "escalationFields",
                name: "escalationFields",
                cols: {
                    label: { heading: 'Label', type: 'singleline', placeholder: 'Full Name' },
                    handle: { heading: 'Handle', type: 'singleline', code: true, placeholder: 'name' },
                    type: {
                        heading: 'Type',
                        type: 'select',
                        options: [
                            { label: 'Text', value: 'text' },
                            { label: 'Email', value: 'email' },
                            { label: 'Phone', value: 'tel' },
                            { label: 'Textarea', value: 'textarea' },
                            { label: 'Select', value: 'select' },
                            { label: 'Checkbox', value: 'checkbox' },
                        ],
                    },
                    required: { heading: 'Required', type: 'lightswitch', thin: true },
                    placeholder: { heading: 'Placeholder', type: 'singleline', placeholder: 'Enter value…' },
                    options: { heading: 'Options', type: 'singleline', placeholder: 'A, B, C', info: 'Comma-separated. Used for Select and Checkbox types.' },
                },
                rows: fieldRows,
                allowAdd: true,
                allowDelete: true,
                allowReorder: true,
                addRowLabel: "Add a field",
            }) }}
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>Submission Actions</h2>
            <p class="light">Route escalation form submissions to external services — CRMs, helpdesks, Zapier, custom APIs, etc.</p>

            {{ forms.editableTableField({
                label: "Webhook Actions",
                id: "escalationActions",
                name: "escalationActions",
                cols: {
                    enabled: { heading: 'On', type: 'lightswitch', thin: true },
                    name: { heading: 'Name', type: 'singleline', placeholder: 'HubSpot' },
                    url: { heading: 'Endpoint URL', type: 'singleline', placeholder: 'https://hooks.example.com/...' },
                    method: {
                        heading: 'Method',
                        type: 'select',
                        thin: true,
                        options: [
                            { label: 'POST', value: 'POST' },
                            { label: 'PUT', value: 'PUT' },
                            { label: 'PATCH', value: 'PATCH' },
                        ],
                    },
                    format: {
                        heading: 'Format',
                        type: 'select',
                        thin: true,
                        options: [
                            { label: 'JSON', value: 'json' },
                            { label: 'Form', value: 'form' },
                        ],
                    },
                    headers: { heading: 'Headers', type: 'multiline', placeholder: 'Authorization: Bearer xxx' },
                },
                rows: actionRows,
                allowAdd: true,
                allowDelete: true,
                allowReorder: true,
                addRowLabel: "Add an action",
            }) }}
        </div>

        <div class="pane" style="margin-bottom: 24px;">
            <h2>Field Mapping</h2>
            <p class="light">
                Map your form field handles to the external field names expected by your webhook endpoints.
                Supports dot notation for nested payloads (e.g. <code>properties.email</code>).
                If no mapping is defined, form data is sent as-is using the field handles.
            </p>

            {{ forms.editableTableField({
                label: "Field Map",
                id: "escalationFieldMap",
                name: "escalationFieldMap",
                cols: {
                    formHandle: { heading: 'Form Field Handle', type: 'singleline', code: true, placeholder: 'email' },
                    externalName: { heading: 'External / CRM Field Name', type: 'singleline', code: true, placeholder: 'properties.email' },
                },
                rows: fieldMapRows,
                allowAdd: true,
                allowDelete: true,
                allowReorder: false,
                addRowLabel: "Add mapping",
            }) }}

            {% if settings.escalationFields | length %}
                <div style="margin-top: 12px; padding: 12px 16px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <div style="font-size: 12px; font-weight: 600; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Available form handles</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                        {% for field in settings.escalationFields %}
                            <code style="background: #e2e8f0; padding: 2px 8px; border-radius: 4px; font-size: 13px;">{{ field.handle }}</code>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

{% endblock %}
