{% extends "craft-ai-assistant/settings/_layout" %}
{% import "_includes/forms" as forms %}
{% set title = "Settings" %}
{% set settingsTab = "restrictions" %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('craft-ai-assistant/restrictions/save') }}
    {{ redirectInput('craft-ai-assistant/settings/restrictions') }}

    {{ parent() }}
{% endblock %}

{% block settingsContent %}
    <div class="pane" style="margin-bottom: 24px;">
        <h2>Topic Restrictions</h2>
        <p class="light">Control what topics the AI agent can and cannot discuss.</p>

        {{ forms.textareaField({
            label: "Allowed Topics",
            instructions: "One topic per line. If set, the agent will only discuss these topics — anything else, including ordinary questions about the business such as opening hours or pricing, gets the off-topic fallback. Enforced by a separate scope check before each answer, so it adds one short API call per message; leave empty to allow all topics and skip that call.",
            id: "allowedTopics",
            name: "allowedTopics",
            value: settings.allowedTopics,
            rows: 5,
            class: "code fullwidth",
            placeholder: "Product information\nPricing\nSupport questions",
        }) }}

        {{ forms.textareaField({
            label: "Disallowed Topics",
            instructions: "One topic per line. The agent will refuse to discuss these topics.",
            id: "disallowedTopics",
            name: "disallowedTopics",
            value: settings.disallowedTopics,
            rows: 5,
            class: "code fullwidth",
            placeholder: "Competitors\nPolitics\nPersonal opinions",
        }) }}
    </div>

    <div class="pane" style="margin-bottom: 24px;">
        <h2>Fallback Messages</h2>

        {{ forms.textareaField({
            label: "Off-Topic Fallback",
            instructions: "Shown when a user asks about a restricted or off-topic subject.",
            id: "fallbackMessage",
            name: "fallbackMessage",
            value: settings.fallbackMessage,
            rows: 3,
            class: "fullwidth",
        }) }}

        {{ forms.textareaField({
            label: "Error Fallback",
            instructions: "Shown when something goes wrong (API errors, timeouts, etc.).",
            id: "errorMessage",
            name: "errorMessage",
            value: settings.errorMessage,
            rows: 3,
            class: "fullwidth",
        }) }}
    </div>

    <div class="pane" style="margin-bottom: 24px;">
        <h2>Rate Limiting</h2>

        {{ forms.textField({
            label: "Max Message Length (characters)",
            instructions: "Longest message a user can send. Keeps token cost per message predictable and stays well under the URL-length limits reverse proxies impose on the streaming endpoint.",
            id: "maxMessageLength",
            name: "maxMessageLength",
            value: settings.maxMessageLength,
            type: "number",
            min: 100,
            max: 8000,
            size: 10,
        }) }}

        {{ forms.textField({
            label: "Rate Limit (messages per minute)",
            instructions: "Maximum messages a single session can send per minute.",
            id: "rateLimitPerMinute",
            name: "rateLimitPerMinute",
            value: settings.rateLimitPerMinute,
            type: "number",
            min: 1,
            max: 60,
            size: 10,
        }) }}

        {{ forms.textField({
            label: "Rate Limit per IP (messages per minute)",
            instructions: "Maximum messages from one IP address per minute, counted across all its sessions. Catches abuse that rotates the session ID to dodge the per-session limit. Set to 0 to disable.",
            id: "rateLimitPerMinutePerIp",
            name: "rateLimitPerMinutePerIp",
            value: settings.rateLimitPerMinutePerIp,
            type: "number",
            min: 0,
            max: 600,
            size: 10,
        }) }}

        {{ forms.textField({
            label: "Daily Message Limit (site-wide)",
            instructions: "Hard cap on total user messages per day across the whole site, as a runaway-cost safeguard. Set to 0 to disable.",
            id: "dailyMessageLimit",
            name: "dailyMessageLimit",
            value: settings.dailyMessageLimit,
            type: "number",
            min: 0,
            size: 10,
        }) }}
    </div>

    <div class="pane" style="margin-bottom: 24px;">
        <h2>Knowledge Base Search</h2>

        {{ forms.textField({
            label: "Minimum Relevance Score",
            instructions: "Cosine-similarity threshold (0–1) a knowledge base chunk must reach to be used as context. Chunks below this are dropped; if none qualify, the agent is told nothing relevant was found instead of being fed low-relevance noise. 0 disables the filter. Typical: 0.25–0.35.",
            id: "searchMinScore",
            name: "searchMinScore",
            value: settings.searchMinScore,
            type: "number",
            min: 0,
            max: 1,
            step: 0.05,
            size: 10,
        }) }}
    </div>

    <div class="pane" style="margin-bottom: 24px;">
        <h2>Site Content Search</h2>
        <p class="light">Lets the agent search the site's own entries (pages, articles, products) through Craft's search index, alongside the file-based knowledge base.</p>

        {{ forms.lightswitchField({
            label: "Enable Site Content Search",
            instructions: "Adds the search_site_content tool. Only live entries with a public URL are ever returned.",
            id: "contentSearchEnabled",
            name: "contentSearchEnabled",
            on: settings.contentSearchEnabled,
        }) }}

        {{ forms.textareaField({
            label: "Searchable Sections",
            instructions: "Section handles the agent may search, one per line. Leave empty to allow every section with public URLs.",
            id: "contentSearchSections",
            name: "contentSearchSections",
            value: settings.contentSearchSections,
            rows: 4,
            class: "code fullwidth",
            placeholder: "blog\nproducts",
        }) }}
    </div>
{% endblock %}
